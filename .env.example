PORTAL_SIGNING_KEY=
PORTAL_ORIGIN=https://kjl-designs.vercel.app
PORTAL_NAMESPACE=kjl-studio-v1
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Existing studio AI configuration, also reused by project discovery.
OPENAI_API_KEY=
